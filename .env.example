# Brook Music Bot - environment template
# Copy to .env.local (or set as Heroku config vars). Every value is optional
# except BOT_TOKEN.

# ── Telegram ─────────────────────────────────────────────────────────────────
# Token from @BotFather (required to run the bot).
BOT_TOKEN=
# Numeric Telegram user ID of the owner (grants /addsudo + admin).
OWNER_ID=
# Password for the /admin HTTP dashboard (HTTP Basic auth, user "admin").
ADMIN_PASSWORD=

# ── HTTP API server (Heroku sets PORT automatically) ─────────────────────────
PORT=8000
METRICS_HTTP_ENABLED=false
METRICS_HTTP_TOKEN=
METRICS_PROMETHEUS_ENABLED=false

# ── YouTube (InnerTube search first, Invidious + Piped as fallback) ──────────
# Search runs natively against YouTube's InnerTube web API (no key/instances
# needed). The instance lists below are only used as a concurrent fallback and
# are probed in parallel with a 3s per-host timeout — dead hosts are skipped
# instantly, no serial sleeps, and only a true 429 counts as "rate limited".
# No yt-dlp binary is used for search; playback resolution tries InnerTube
# player, then instances, then Apple preview snippets.
INVIDIOUS_INSTANCES=invidious.nerdvpn.de,vid.puffyan.us,inv.nadeko.net,invidious.f5.si,iv.ggtyler.dev
PIPED_INSTANCES=pipedapi.kavin.rocks,pipedapi.tokhmi.xyz,piped-api.garudalinux.org,pipedapi.reallyaweso.me
# Set false to disable YouTube entirely.
YOUTUBE_ENABLED=true
# yt-dlp subprocess used to extract a direct audio URL when InnerTube's player
# endpoint is bot-guarded (e.g. datacenter IPs). No yt-dlp present? The bot
# skips it gracefully and falls back to the instances/Apple preview.
YT_DLP_ENABLED=true
# YT_DLP_BINARY=yt-dlp
# YT_DLP_TIMEOUT_SECS=20

# ── Spotify (metadata via official Web API; audio via YouTube) ───────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Apple Music (metadata via public iTunes Search API; audio via YouTube) ───
# No credentials required.

# ── SoundCloud (official api-v2 with a client_id; audio via direct streams) ──
SOUNDCLOUD_CLIENT_ID=

# ── Resolution tuning ────────────────────────────────────────────────────────
# TTL in seconds for in-memory search-result caching (lowers upstream traffic).
RESOLVER_CACHE_TTL_SECS=300
# TTL in seconds for resolved stream URLs. A cached play skips the expensive
# re-resolution step (default 3600 = 1 hour).
RESOLVER_STREAM_CACHE_TTL_SECS=3600
# Max size (MB) for direct audio streams. Prevents unbounded downloads.
MAX_DIRECT_STREAM_MB=100
# Comma-separated list of allowed redirect hosts for direct links.
# When set, direct URLs that redirect to other hosts will be rejected.
# ALLOWED_DIRECT_HOSTS=cdn.example.com,media.example.org

# ── Queue / playback ─────────────────────────────────────────────────────────
MAX_QUEUE_SIZE=100
DEFAULT_VOLUME=100
COMMAND_COOLDOWN=3
# Max concurrent upstream track resolutions. A busy group can't hammer the
# platform APIs all at once (rate-limit / IP-ban protection).
MAX_CONCURRENT_RESOLUTIONS=4

# ── Voice chat streaming (assistant account) ────────────────────────────────
# The Bot API CANNOT stream audio into voice chats (phone.joinGroupCall is
# user-only). Real music playback needs a dedicated assistant USER account that
# joins the voice chat and streams, driven by ferogram (MTProto) + tgcalls.
#
# 1. Get API_ID / API_HASH from https://my.telegram.org/api
# 2. Run `brook-music-bot --export-session` once on a machine with a TTY; it
#    logs in with the assistant phone number (+ optional 2FA) and prints a
#    session string.
# 3. On Heroku, set ASSISTANT_SESSION_STRING to that value (no interactive login
#    needed). Locally you can also just keep the generated assistant.session file.
TG_API_ID=
TG_API_HASH=
# Local session file path (default: assistant.session). Ignored when
# ASSISTANT_SESSION_STRING is set.
# ASSISTANT_SESSION=assistant.session
ASSISTANT_SESSION_STRING=

# ── NVIDIA NIM AI Inference (Receiver Layer query understanding & normalization) ─
# Obtain API key from https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# ── Legacy optional music microservice (not used by the new built-in resolvers).
MUSIC_MICROSERVICE_URL=